digraph G {
graph [fontname="DejaVu Sans",bgcolor="white",pad="0.25",nodesep="0.32",ranksep="0.8",splines=polyline];node [fontname="DejaVu Sans",fontsize=12,color="#74180f",fontcolor="#383331",style=filled,fillcolor="#faf8f3",penwidth=1.2];edge [fontname="DejaVu Sans",fontsize=10,color="#756d67",fontcolor="#534e4b",arrowsize=.7];
rankdir=LR;node[shape=plain];areas[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>areas</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">name UNIQUE</TD></TR></TABLE>>];users[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">area_id FK &#8594; areas</TD></TR><TR><TD ALIGN="LEFT">name, email UNIQUE</TD></TR><TR><TD ALIGN="LEFT">password, role, active</TD></TR></TABLE>>];categories[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">name UNIQUE</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR></TABLE>>];documents[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">category_id FK &#8594; categories</TD></TR><TR><TD ALIGN="LEFT">owner_id FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">area_id FK &#8594; areas</TD></TR><TR><TD ALIGN="LEFT">reviewed_by FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">title, visibility, status</TD></TR><TR><TD ALIGN="LEFT">storage, filename, size</TD></TR><TR><TD ALIGN="LEFT">academic_year, removed</TD></TR></TABLE>>];versions[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">document_id FK &#8594; documents</TD></TR><TR><TD ALIGN="LEFT">created_by FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">number, storage, sha256</TD></TR><TR><TD ALIGN="LEFT">UNIQUE(document_id, number)</TD></TR></TABLE>>];reviews[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">document_id FK &#8594; documents</TD></TR><TR><TD ALIGN="LEFT">user_id FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">version_number (sin FK física)</TD></TR><TR><TD ALIGN="LEFT">status, comment, created_at</TD></TR></TABLE>>];sessions[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">token PK</TD></TR><TR><TD ALIGN="LEFT">user_id FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">expires</TD></TR></TABLE>>];activity[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#74180f"><FONT COLOR="white"><B>activity</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id PK</TD></TR><TR><TD ALIGN="LEFT">user_id FK &#8594; users</TD></TR><TR><TD ALIGN="LEFT">action, detail, created_at</TD></TR></TABLE>>];areas -> users [label="1 : 0..N · area_id",arrowhead=crow,fontsize=9];users -> documents [label="1 : 0..N · reviewed_by",arrowhead=crow,fontsize=9];areas -> documents [label="1 : 0..N · area_id",arrowhead=crow,fontsize=9];users -> documents [label="1 : 0..N · owner_id",arrowhead=crow,fontsize=9];categories -> documents [label="1 : 0..N · category_id",arrowhead=crow,fontsize=9];users -> versions [label="1 : 0..N · created_by",arrowhead=crow,fontsize=9];documents -> versions [label="1 : 0..N · document_id",arrowhead=crow,fontsize=9];users -> reviews [label="1 : 0..N · user_id",arrowhead=crow,fontsize=9];documents -> reviews [label="1 : 0..N · document_id",arrowhead=crow,fontsize=9];users -> sessions [label="1 : 0..N · user_id",arrowhead=crow,fontsize=9];users -> activity [label="1 : 0..N · user_id",arrowhead=crow,fontsize=9];
}